# Provedor padrão: openai ou gemini
AI_PROVIDER=openai

# OpenAI: chave em https://platform.openai.com/api-keys
# Faturamento da API é separado da assinatura do ChatGPT.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Alternativa opcional: Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Porta do backend (padrão: 5000)
# PORT=5000
