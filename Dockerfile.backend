# Base Node.js Alpine (leve e seguro)
FROM node:18-alpine

WORKDIR /app

# Copia manifestos de dependências
COPY package*.json ./

# Instala dependências de produção
RUN npm install --omit=dev

# Copia arquivos do servidor e da aplicação
COPY server.js ./
COPY .env* ./

# Expõe a porta do backend
ENV PORT=5000
EXPOSE 5000

# Executa o servidor Express
CMD ["node", "server.js"]
