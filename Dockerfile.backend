# syntax=docker/dockerfile:1
FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt ./
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export PIP_CERT=/run/secrets/proxy_ca; fi; \
    python -m pip install --no-cache-dir -r requirements.txt
COPY --chmod=444 server.py local_vision.py model_manifest.json ./
COPY --chmod=555 scripts/download_model.py ./scripts/download_model.py
RUN mkdir -p /app/models /app/public && chown -R 65534:65534 /app/models /app/public
ENV PORT=5000 PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 LOCAL_MODEL_DIR=/app/models LOCAL_PRELOAD=1
USER 65534:65534
EXPOSE 5000
CMD ["python", "server.py"]
