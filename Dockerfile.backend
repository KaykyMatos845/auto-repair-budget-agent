# syntax=docker/dockerfile:1
FROM python:3.12-slim AS model
WORKDIR /model
COPY model_manifest.json ./
COPY scripts/download_model.py ./scripts/download_model.py
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export SSL_CERT_FILE=/run/secrets/proxy_ca; fi; \
    LOCAL_MODEL_DIR=/model/weights python scripts/download_model.py

FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt ./
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export PIP_CERT=/run/secrets/proxy_ca; fi; \
    python -m pip install --no-cache-dir --only-binary=:all: -r requirements.txt && python -m pip check
COPY --chmod=444 server.py local_vision.py model_manifest.json ./
COPY --from=model --chmod=444 /model/weights/model.onnx /app/models/model.onnx
COPY --chmod=444 MODEL_CARD.md ./MODEL_CARD.md
RUN mkdir -p /app/public && chmod 755 /app/models /app/public
ENV PORT=5000 PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 LOCAL_MODEL_DIR=/app/models LOCAL_PRELOAD=1
USER 65534:65534
EXPOSE 5000
HEALTHCHECK --interval=15s --timeout=5s --start-period=45s --retries=3 CMD python -c "import json,urllib.request; assert json.load(urllib.request.urlopen('http://127.0.0.1:5000/api/health', timeout=3))['modelLoaded']"
CMD ["python", "server.py"]
