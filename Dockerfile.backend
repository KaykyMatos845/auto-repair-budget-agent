# Imagem leve Python 3.11 para o servidor da API
FROM python:3.11-slim

WORKDIR /app

# Copia o servidor Python (backend completo com Gemini AI, FIPE, Market Prices)
COPY server.py ./

# Copia .env se existir (a chave também pode vir por variável de ambiente)
COPY .env* ./

# Porta do backend
ENV PORT=5000
EXPOSE 5000

# Executa o servidor Python
CMD ["python", "server.py"]
