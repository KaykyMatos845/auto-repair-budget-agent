FROM python:3.12-slim
WORKDIR /app
COPY --chmod=444 monitor_proxy.py ./
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
EXPOSE 2375
HEALTHCHECK --interval=15s --timeout=10s --start-period=20s --retries=3 CMD python -c "import http.client; c=http.client.HTTPConnection('127.0.0.1',2375,timeout=5); c.request('GET','/healthz'); r=c.getresponse(); assert r.status == 200; r.read(); c.close()"
CMD ["python", "monitor_proxy.py"]
